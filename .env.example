# Copy to .env and fill in. Never commit the real values.

# --- backend ---
# SQLite is fine locally. Use PostgreSQL in production.
DATABASE_URL=sqlite:///./pulse.db
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/pulse

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-before-deploying

ACCESS_TOKEN_MINUTES=1440

# How often the scheduler looks for monitors that are due.
PROBE_INTERVAL_SECONDS=60
PROBE_TIMEOUT_SECONDS=10

# Turn off in tests so the background task does not run.
SCHEDULER_ENABLED=true

# Rows to keep per monitor. Older checks are pruned.
CHECK_RETENTION=500

# Comma separated. Use your frontend origin in production, not *.
CORS_ORIGINS=http://localhost:5173

# --- frontend ---
# Leave blank in development; Vite proxies /api to the backend.
VITE_API_URL=
# In production point it at the deployed API:
# VITE_API_URL=https://pulse-api.onrender.com
